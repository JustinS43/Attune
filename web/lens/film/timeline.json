  "speech": [
    { "id": "jess1",   "who": "jess",  "scene": "dinner",     "t0": 8.30,  "t1": 10.60, "text": "Wait — who told Grandpa about the surprise?" },
    { "id": "mark1",   "who": "mark",  "scene": "dinner",     "t0": 10.40, "t1": 11.80, "text": "Not me! I swear." },
    { "id": "mom0",    "who": "mom",   "scene": "dinner",     "t0": 11.90, "t1": 14.60, "text": "Dessert's ready! Someone grab the plates.", "offscreen": { "side": "left", "where": "Kitchen" } },
    { "id": "mom_qs",  "who": "mom",   "scene": "qs_mom",     "t0": 17.40, "t1": 19.80, "text": "Hi sweetie! Is it recording?" },
    { "id": "mia1",    "who": "mia",   "scene": "cafe",       "t0": 25.30, "t1": 27.60, "text": "Alex! This is my cousin, Andre!", "names": ["Andre"] },
    { "id": "andre1",  "who": "andre", "scene": "cafe",       "t0": 29.00, "t1": 31.40, "text": "Hey! Mia's told me so much about you.", "unnamed": true },
    { "id": "you1",    "who": "you",   "scene": "cafe",       "t0": 31.50, "t1": 33.10, "text": "Good things, I hope! Nice to meet you, Andre.", "names": ["Andre"] },
    { "id": "andre2",  "who": "andre", "scene": "cafe",       "t0": 33.80, "t1": 36.60, "text": "So… who's ready to lose at bowling?" },
    { "id": "leo1",    "who": "leo",   "scene": "translate",  "t0": 37.50, "t1": 40.10, "text": "This shake is incredible!", "orig": "¡Este batido está buenísimo!", "lang": "ES" },
    { "id": "leo2",    "who": "leo",   "scene": "translate",  "t0": 40.20, "t1": 42.80, "text": "Should we order another round?", "orig": "¿Pedimos otra ronda?", "lang": "ES" },
    { "id": "mom1",    "who": "mom",   "scene": "finale",     "t0": 66.60, "t1": 68.40, "text": "I'm so glad you're here, sweetheart." },
    { "id": "mom2",    "who": "mom",   "scene": "finale",     "t0": 68.90, "t1": 70.60, "text": "Merry Christmas." }
  ],
  "supers": [
    { "t0": 0.40,  "t1": 2.60,  "text": "Everyone's talking.",                          "style": "hero" },
    { "t0": 2.80,  "t1": 4.90,  "text": "You're missing half of it.",                   "style": "hero" },
    { "t0": 12.40, "t1": 14.85, "text": "Every voice gets a name — even off-screen.", "style": "lower" },
    { "t0": 15.40, "t1": 17.90, "text": "Start with the people who matter most.",       "style": "lower" },
    { "t0": 22.30, "t1": 24.90, "text": "Recognized instantly. Every time.",            "style": "lower" },
    { "t0": 25.20, "t1": 27.00, "text": "Meet someone new?",                             "style": "lower" },
    { "t0": 34.20, "t1": 36.85, "text": "It learns names the way you do.",              "style": "lower" },
    { "t0": 38.00, "t1": 42.70, "text": "Any language. In your words.",                 "style": "lower" },
    { "t0": 43.30, "t1": 45.30, "text": "Not every sound is a voice.",                  "style": "lower" },
    { "t0": 52.60, "t1": 54.85, "text": "Alerts you can see — and feel.",          "style": "lower" },
    { "t0": 60.00, "t1": 61.90, "text": "Awareness, all around you.",                   "style": "lower" },
    { "t0": 70.40, "t1": 73.80, "text": "Be part of every conversation.",               "style": "hero" }
  ],
