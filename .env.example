# Copy to .env (gitignored). A human types the real values; agents never handle them.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
OLLAMA_HOST=http://localhost:11434
# Optional cloud captions (Google Speech-to-Text; off until the wearer turns them on in Settings).
# An API key restricted to the Cloud Speech-to-Text API (Settings can save it here for you)...
GOOGLE_SPEECH_API_KEY=
# ...or, instead, the full path of a service-account JSON key file with Speech-to-Text access.
GOOGLE_APPLICATION_CREDENTIALS=
